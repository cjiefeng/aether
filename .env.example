# Copy to .env and `chmod 600 .env`. Never commit .env.
# Values are interpolated by docker compose and passed only to the service that needs them.

# --- Anthropic (dedicated Console workspace with a monthly spend limit; separate dev/app keys) ---
ANTHROPIC_API_KEY=
# M7: classifier (no tools). Default claude-sonnet-5-5.
CLASSIFIER_MODEL=
SYNTH_MODEL=
DAILY_LLM_BUDGET_USD=5.00
# M6: research runs (Claude web search). Default claude-opus-5-5.
RESEARCH_MODEL=
# M6: the one-time 12-month backfill (Message Batches, outside the daily soft budget, roughly
# $10-15 with Opus) runs automatically once ANTHROPIC_API_KEY is set. Set to false to skip it.
RESEARCH_BACKFILL=
# M11: escalations per SGT day (alert + verification research + re-synthesis). Default 5.
MAX_ESCALATIONS_PER_DAY=
# M12: monthly universe review. Model for its deep research and proposal (default
# claude-opus-5-5) and its own per-run cap in USD (default 10.00, separate from the daily budget).
RESEARCH_DEEP_MODEL=
UNIVERSE_REVIEW_BUDGET_USD=

# --- SEC EDGAR: "Name contact@example.com" (sent only to sec.gov) ---
SEC_USER_AGENT=

# --- Prices: Massive (formerly Polygon) free "Stocks Basic" key; fallback when yfinance fails ---
MASSIVE_API_KEY=

# --- Logging (M11): json (default in compose) or text ---
AETHER_LOG_FORMAT=

# --- Dashboard ---
# Optional; random per process if empty (CSRF tokens then reset on app restart).
AETHER_CSRF_SECRET=
# Required (M5): `make hash-password` prints both lines. The app won't start without them.
AETHER_DASHBOARD_PASSWORD_HASH=
AETHER_SESSION_SECRET=

# --- Tiger Brokers (M5, optional; read-only holdings sync; worker only) ---
# TIGER_PRIVATE_KEY: the RSA private key body (PEM headers optional; newlines may be written as \n).
TIGER_ID=
TIGER_PRIVATE_KEY=
TIGER_ACCOUNT=

# --- Telegram (M3; owner-only — numeric IDs, never @username) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_CHAT_ID=
