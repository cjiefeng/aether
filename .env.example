# Copy to .env and `chmod 600 .env`. Never commit .env.
# Values are interpolated by docker compose and passed only to the service that needs them.

# --- Anthropic (dedicated Console workspace with a monthly spend limit; separate dev/app keys) ---
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=
SYNTH_MODEL=
DAILY_LLM_BUDGET_USD=3.00

# --- SEC EDGAR: "Name contact@example.com" (sent only to sec.gov) ---
SEC_USER_AGENT=

# --- Dashboard ---
# Optional; random per process if empty (CSRF tokens then reset on app restart).
AETHER_CSRF_SECRET=

# --- Telegram (M3; owner-only — numeric IDs, never @username) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_CHAT_ID=
